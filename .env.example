# Секреты и ручки окружения. Скопируй в .env рядом с docker-compose.yml НА СЕРВЕРЕ
# (в git этот файл не едет, и на прод его не увозит deploy.sh — правится на месте).
#
# Всё здесь опционально: без единой переменной сервер поднимется, отдаст файлы
# контекста и примет письмо в data/inbox.jsonl.

# --- ask: синтез-ответ через LLM -------------------------------------------
# Выключен по умолчанию (context/config.json → ask.enabled). Включаешь — платишь ты:
# ключ твой, потолки твои. Без ключа тулза вежливо отказывает и отсылает к файлам.
# ASK_ENABLED=true
# ANTHROPIC_API_KEY=sk-ant-...
# ASK_MODEL=claude-sonnet-5-5
# ASK_CALLS_PER_DAY=20
# ASK_TOKENS_PER_DAY=150000

# --- leave_message: куда тебя дёрнуть о письме ------------------------------
# Ни один канал не обязателен: письмо в любом случае ложится в data/inbox.jsonl.
# Telegram — бот через @BotFather, chat id — свой собственный.
# NOTIFY_TG_BOT_TOKEN=123456:AA...
# NOTIFY_TG_CHAT_ID=123456789

# Почта — Resend (обычный HTTP API, без SMTP и без новых зависимостей).
# Нужны все три: домен у FROM должен быть верифицирован в Resend.
# NOTIFY_RESEND_API_KEY=re_...
# NOTIFY_EMAIL_TO=you@example.com
# NOTIFY_EMAIL_FROM=mcp@example.com

# --- всё остальное ----------------------------------------------------------
# PORT=3000
# DATA_DIR=/app/data
# CONTEXT_DIR=context
# SERVE_DISCOVERY=true          # свои /llms.txt и /.well-known/mcp/server-card.json
# MCP_PUBLIC_URL=https://example.com/mcp
