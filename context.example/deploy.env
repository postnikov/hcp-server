# Ручки деплоя: адрес сервера, домен и имена docker-сущностей.
# Читается ТОЛЬКО скриптом ./deploy.sh (локально) и docker compose на VPS —
# в приложение ничего отсюда не попадает. Секретов здесь нет: они в .env на сервере.
#
#   cp context.example/deploy.env context/deploy.env   и поправь под себя.

# Куда деплоим.
DEPLOY_SERVER=root@203.0.113.10
DEPLOY_DIR=/opt/hcp-mcp

# Публичный адрес MCP: он же в config.json, он же в смоуке после деплоя.
MCP_PUBLIC_URL=https://example.com/mcp

# Traefik: домен, имя роутера (должно быть уникально на весь traefik),
# приоритет (выше, чем у роутера сайта, иначе /mcp уедет на сайт) и certresolver.
MCP_DOMAIN=example.com
MCP_ROUTER=hcpmcp
MCP_ROUTER_PRIORITY=1000
MCP_TLS_CERTRESOLVER=myresolver

# Имена docker-сущностей. Volume переименовывать после первого запуска НЕЛЬЗЯ:
# новое имя — новый пустой том, журнал и инбокс останутся в старом.
MCP_CONTAINER_NAME=hcp-mcp
MCP_VOLUME_NAME=hcp-mcp-data
